<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Proxies.Tests</RootNamespace>
		<AssemblyName>Proxies.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- CA2000 - dispose (test scope): HttpResponseMessage instances built for WebShareAdapterTests'
		     stub handler live for the duration of the test method and are not worth wrapping in
		     `using`, matching the same suppression used by Integration.Tests / Integration.Middleware.Tests. -->
		<NoWarn>$(NoWarn);CA1515;CA1861;CA1707;CA2000</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="coverlet.collector" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Modules\Proxies\Modules.Proxies\Modules.Proxies.csproj" />
	</ItemGroup>

</Project>

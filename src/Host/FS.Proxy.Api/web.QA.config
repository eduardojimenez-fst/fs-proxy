<?xml version="1.0" encoding="utf-8"?>
<!--
  XDT transform applied to web.config when publishing with <EnvironmentName>QA</EnvironmentName>
  (IIS-QA.pubxml). The SDK picks up web.$(EnvironmentName).config automatically.

  Why this file exists: OpenTelemetry resolves service.name as OTEL_SERVICE_NAME ?? ApplicationName,
  and ApplicationName is "FS.Proxy.Api" in every environment because it comes from the assembly. QA
  and Production ship to the same collector at 10.0.1.4:4317, so without this both would land under
  one resource and their traces, metrics and logs would be indistinguishable.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <location>
    <system.webServer>
      <aspNetCore>
        <environmentVariables>
          <environmentVariable name="OTEL_SERVICE_NAME" value="FS.Proxy-QA.Api"
                               xdt:Transform="Insert" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>

{
  // QA mirrors Production closely — the point of QA is to behave like prod, so anything that differs
  // here differs on purpose. Environment name is "QA" (set by IIS-QA.pubxml's <EnvironmentName>), which
  // means IsDevelopment() is false everywhere (no EF sensitive-data logging, no demo seeding, no
  // lenient JWT errors) — but IsProduction() is also false, so the explicit fail-fast block in
  // Program.cs does not run. Options validation still guards DatabaseOptions and JwtOptions on start;
  // CachingOptions:Redis is the one that would silently fall back to an in-memory cache if left blank,
  // so keep it populated.
  "OpenTelemetryOptions": {
    "Enabled": true,
    "Tracing": { "Enabled": true },
    "Metrics": { "Enabled": true },
    "Exporter": {
      "Otlp": {
        "Enabled": true,
        "Endpoint": "http://10.0.1.4:4317",
        "Protocol": "grpc"
      }
    },
    "Jobs": { "Enabled": true },
    "Mediator": { "Enabled": true },
    "Http": { "Histograms": { "Enabled": true } },
    "Data": { "FilterEfStatements": true, "FilterRedisCommands": true }
  },
  "Serilog": {
    // Same shape as Production: the OTLP log sink is added in code, not declared here, so declaring it
    // would double every record. QA and Production share one collector, and the code resolves
    // service.name from OTEL_SERVICE_NAME ?? ApplicationName — with ApplicationName being "FS.Proxy.Api"
    // in both. web.QA.config sets OTEL_SERVICE_NAME=FS.Proxy-QA.Api so the two do not merge into one
    // resource in the collector.
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId", "WithProcessId", "WithProcessName" ],
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console", "Args": { "restrictedToMinimumLevel": "Information" } },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "DatabaseOptions": {
    "Provider": "MSSQL",
    "ConnectionString": "Data Source=fsqa1server.southcentralus.cloudapp.azure.local;Initial Catalog=FS.Proxy;User Id=usr_fs_proxy;Password=Falconsoft!2O26;MultipleActiveResultSets=True;Application Name=FS.Proxy.Api;TrustServerCertificate=True;Encrypt=True;Min Pool Size=5",
    "MigrationsAssembly": "FS.Proxy.Migrations.MSSQL"
  },
  "OriginOptions": {
    "OriginUrl": "https://proxy-api-qa.falcontenders.com"
  },
  "CachingOptions": {
    // Same Redis instance as Production, isolated by database index. Without defaultDatabase both
    // environments would share cache keys (tenant ids collide — both have "root") and the same SignalR
    // backplane, so a QA cache invalidation or realtime message could reach production clients.
    // Data Protection is already isolated: DataProtection:Store=Database, and the QA database is separate.
    "Redis": "10.0.1.4:6379,password=R3disF1lc0n26!,defaultDatabase=1"
  },
  "HangfireOptions": {
    // Jobs are stored in SQL Server on the QA connection string, so the queue itself is isolated.
    // This is only the dashboard's basic auth, and /jobs is internet-reachable.
    "UserName": "admin",
    "Password": "Falconsoft!2O26",
    "Route": "/jobs"
  },
  "AllowedHosts": "*",
  "OpenApiOptions": {
    "Enabled": true,
    "Title": "FS Proxy API (QA)",
    "Version": "v1",
    "Description": "FS Proxy API — QA environment.",
    "Contact": { "Name": "Falcon Soft", "Url": "https://falcontenders.com", "Email": "soporte@falcontenders.com" },
    "License": { "Name": "MIT License", "Url": "https://opensource.org/licenses/MIT" }
  },
  "CorsOptions": {
    // Exact scheme+host+port compare, no trailing slash. Headers must cover what the clients send:
    // "tenant", "idempotency-key", and the SignalR negotiate pair.
    "AllowAll": false,
    "AllowedOrigins": [ "https://proxy-qa.falcontenders.com" ],
    "AllowedHeaders": [ "content-type", "authorization", "tenant", "idempotency-key", "x-requested-with", "x-signalr-user-agent" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
  },
  "JwtOptions": {
    // Distinct signing key, issuer and audience from Production, so a token minted in QA cannot be
    // replayed against production (the signature check alone would reject it; the issuer/audience
    // difference makes the separation explicit).
    "Issuer": "fs-proxy-qa.api",
    "Audience": "fs-proxy-qa.clients",
    "SigningKey": "21TB6lvLcAsW6HUXZWPwQK3heXE09VWsKcIhf4sT7zZxe9X34v5xZ7+P+t69Q1B9",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "SecurityHeadersOptions": {
    "Enabled": true,
    "ExcludedPaths": [ "/scalar", "/openapi" ],
    "AllowInlineStyles": true,
    "ScriptSources": [],
    "StyleSources": []
  },
  "MailOptions": {
    // TODO: same gap as Production — no SMTP credentials, so no outbound email.
    "UseSendGrid": false,
    "From": "noreply@falcontenders.com",
    "DisplayName": "FS Proxy (QA)",
    "SMTP": {
      "Host": "",
      "Port": 587,
      "UserName": "",
      "Password": ""
    }
  },
  "RateLimitingOptions": {
    // Deliberately identical to Production: a limit that would bite a real client shows up in QA first.
    "Enabled": true,
    "Tenant": { "PermitLimit": 1000, "WindowSeconds": 60, "QueueLimit": 0 },
    "User": { "PermitLimit": 200, "WindowSeconds": 60, "QueueLimit": 0 },
    "Ip": { "PermitLimit": 300, "WindowSeconds": 60, "QueueLimit": 0 },
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 }
  },
  "Storage": {
    "Provider": "local"
  },
  "Seed": {
    "DefaultAdminPassword": "Falconsoft!2O26"
  }
}

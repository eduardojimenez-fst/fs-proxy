{
  "Billing": {
    "DefaultPlanKey": "free",
    "GracePeriodDays": 7
  },
  "OpenTelemetryOptions": {
    "Enabled": true,
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true,
      "MeterNames": [ "FSH.Modules.Identity", "FSH.Modules.Multitenancy", "FSH.Modules.Auditing" ]
    },
    "Exporter": {
      "Otlp": {
        "Enabled": false,
        "Endpoint": "http://localhost:4317",
        "Protocol": "grpc"
      }
    },
    "Jobs": { "Enabled": true },
    "Mediator": { "Enabled": true },
    "Http": {
      "Histograms": {
        "Enabled": true
      }
    },
    "Data": {
      "FilterEfStatements": true,
      "FilterRedisCommands": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId", "WithProcessId", "WithProcessName" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "DatabaseOptions": {
    "Provider": "MSSQL",
    "ConnectionString": "Server=localhost,1433;Database=fsh;User Id=sa;Password=Str0ng_Dev_Pwd!;Min Pool Size=5;TrustServerCertificate=True",
    "MigrationsAssembly": "FS.Proxy.Migrations.MSSQL"
  },
  "OriginOptions": {
    "OriginUrl": "https://localhost:7030"
  },
  "DataProtection": {
    // Data Protection isolates keys by application name, so this MUST be unique per application.
    // Two apps sharing it against one Redis can decrypt each other's auth cookies and tokens.
    "ApplicationName": "FS.Proxy",
    // "Redis" (default) or "Database". Choose Database when the hosts that protect and unprotect
    // data do not reliably share a Redis instance — the DbMigrator is normally run standalone,
    // outside the AppHost wiring that injects a Redis connection string — or when Redis is a cache
    // with eviction, where losing a key takes every session and pending reset token with it.
    "Store": "Database"
  },
  "Multitenancy": {
    // Issuer recorded on the root tenant. Lives here rather than as a constant in the framework
    // so it is per-project in both distribution modes.
    "RootIssuer": "fs-proxy"
  },
  "CachingOptions": {
    "Redis": ""
  },
  "HangfireOptions": {
    "UserName": "",
    "Password": "",
    "Route": "/jobs"
  },
  "PasswordPolicy": {
    "PasswordHistoryCount": 5,
    "PasswordExpiryDays": 90,
    "PasswordExpiryWarningDays": 14,
    "EnforcePasswordExpiry": true
  },
  "AllowedHosts": "*",
  "OpenApiOptions": {
    "Enabled": true,
    "Title": "FS Proxy API",
    "Version": "v1",
    "Description": "The FSH Starter Kit API for Modular/Multitenant Architecture.",
    "Contact": {
      "Name": "FS Proxy",
      "Url": "https://example.com",
      "Email": "noreply@example.com"
    },
    "License": {
      "Name": "MIT License",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },
  "CorsOptions": {
    // AllowedOrigins is empty by design. Configuration arrays merge by index rather than replacing,
    // so any origin listed here would survive into an environment override that lists fewer — a dev
    // localhost origin would stay allowed in Production. Development sets AllowAll instead, and the
    // dev origins live in appsettings.Development.json for reference.
    // With AllowAll false and no origins the CORS middleware is skipped entirely, so this base
    // config fails closed.
    "AllowAll": false,
    "AllowedOrigins": [],
    "AllowedHeaders": [ "content-type", "authorization" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
  },
  "JwtOptions": {
    "Issuer": "fsh.local",
    "Audience": "fsh.clients",
    "SigningKey": "",
    "AccessTokenMinutes": 45,
    "RefreshTokenDays": 7
  },
  "SecurityHeadersOptions": {
    "Enabled": true,
    "ExcludedPaths": [ "/scalar", "/openapi" ],
    "AllowInlineStyles": true,
    "ScriptSources": [],
    "StyleSources": []
  },
  "MailOptions": {
    "UseSendGrid": false,
    "From": "noreply@example.com",
    "DisplayName": "FS Proxy",
    "SMTP": {
      "Host": "smtp.ethereal.email",
      "Port": 587,
      "UserName": "",
      "Password": ""
    },
    "SendGrid": {
      "ApiKey": "",
      "From": "noreply@example.com",
      "DisplayName": "FSH SendGrid"
    }
  },
  "RateLimitingOptions": {
    "Enabled": false,
    "Tenant": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "User": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Ip": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Storage": {
    "Provider": "local"
  },
  "QuotaOptions": {
    "Enabled": false,
    "Redis": "",
    "DefaultPlan": "free",
    "ExemptRootTenant": true,
    "Plans": {
      "free": {
        "ApiCalls": 10000,
        "StorageBytes": 1073741824,
        "Users": 5,
        "ActiveFeatureFlags": 10
      },
      "pro": {
        "ApiCalls": 1000000,
        "StorageBytes": 107374182400,
        "Users": 100,
        "ActiveFeatureFlags": 100
      }
    }
  },
  "ProxiesAlertOptions": {
    "AdminUserId": null
  },
  "ProxiesOptions": {
    "DefaultHealthCheckTargetUrl": "https://www.google.com/generate_204",
    "DefaultHealthCheckTimeoutMs": 5000,
    "HealthCheckIntervalMinutes": 15
  },
  "Files": {
    "UploadUrlTtlMinutes": 15,
    "DownloadUrlTtlMinutes": 60,
    "OrphanRetentionMinutes": 60,
    "SoftDeleteRetentionDays": 30,
    "Categories": {
      "Image":    { "AllowedExtensions": [".jpg",".jpeg",".png",".webp",".gif",".ico"], "MaxBytes": 10485760 },
      "Document": { "AllowedExtensions": [".pdf",".docx",".xlsx",".pptx",".txt",".csv"], "MaxBytes": 26214400 },
      "Archive":  { "AllowedExtensions": [".zip"], "MaxBytes": 52428800 }
    }
  }
}

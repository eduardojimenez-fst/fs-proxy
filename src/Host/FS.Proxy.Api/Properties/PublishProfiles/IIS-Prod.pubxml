<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
	<PropertyGroup>
		<WebPublishMethod>MSDeploy</WebPublishMethod>
		<LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
		<LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
		<LastUsedPlatform>Any CPU</LastUsedPlatform>
		<SiteUrlToLaunchAfterPublish>https://proxy-api.falcontenders.com/scalar</SiteUrlToLaunchAfterPublish>
		<ExcludeApp_Data>false</ExcludeApp_Data>
		<ProjectGuid>ccf8bb54-6768-401a-a85c-7caf16badb3e</ProjectGuid>
		<SelfContained>false</SelfContained>
		<MSDeployServiceURL>fsapp1server.southcentralus.cloudapp.azure.com</MSDeployServiceURL>
		<DeployIisAppPath>FS.Proxy.Api</DeployIisAppPath>
		<RemoteSitePhysicalPath />
		<SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
		<MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
		<EnableMSDeployBackup>true</EnableMSDeployBackup>
		<EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
		<AllowUntrustedCertificate>True</AllowUntrustedCertificate>
		<EnvironmentName>Production</EnvironmentName>
		<UserName>fsapp1server_capo</UserName>
		<_SavePWD>true</_SavePWD>
		<_TargetId>IISWebDeploy</_TargetId>
		<!-- appsettings.Development.json carries dev credentials (JWT signing key, SMTP, Hangfire,
		     seed passwords). It is linked into the DbMigrator and copied to the build output, so it
		     would otherwise be published to the server alongside the Production config. -->
		<ExcludeFilesFromDeployment>appsettings.Development.json</ExcludeFilesFromDeployment>
	</PropertyGroup>
</Project>
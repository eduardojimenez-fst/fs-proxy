<?xml version="1.0" encoding="utf-8"?>
<!--
  Local packaging check. FileSystem is the one publish method the .NET SDK implements on every
  platform (FTP is Visual Studio-only, MSDeploy needs msdeploy.exe), so this is how the payload gets
  verified before trusting the FTP profile:

    dotnet publish deploy/iis/FS.Proxy.Admin.Web -p:PublishProfile=Folder-Test

  The result should contain index.html, assets/, web.config and a config.json holding the production
  apiBase — and no .dll, .deps.json or .runtimeconfig.json.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <!-- publishUrl is what Visual Studio reads; `dotnet publish` ignores it and honours
         PublishDir instead. Both are set so the output lands in the same place either way. -->
    <publishUrl>bin/Release/publish-test/</publishUrl>
    <PublishDir>bin/Release/publish-test/</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
</Project>

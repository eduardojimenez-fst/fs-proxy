<?xml version="1.0" encoding="utf-8"?>
<!--
  Admin SPA → IIS site "FS.Proxy" on fsapp1server, over FTP with explicit TLS.

  Visual Studio only. `dotnet publish -p:PublishProfile=IIS-Prod` will NOT work: FTP is implemented
  in Visual Studio's web publishing pipeline, not in Microsoft.NET.Sdk.Publish. Use Folder-Test to
  validate the packaging from the CLI (or from macOS), then publish from VS.

  The password is not stored here — _SavePWD puts it in the sibling IIS-Prod.pubxml.user, which
  .gitignore still excludes.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <ExcludeApp_Data>false</ExcludeApp_Data>

    <!-- Baked into dist/config.json at publish time. The shim project errors out if this is
         unset rather than guessing an environment. -->
    <AdminRuntimeConfig>config.production.json</AdminRuntimeConfig>

    <!-- ftps:// selects explicit TLS on the control channel (port 21 is the default, so it is not
         spelled out). If the publish fails on the data channel, it is almost always IIS FTP
         requiring TLS session reuse, which Visual Studio's FtpWebRequest client does not do —
         either turn that requirement off on the FTP site or upload dist/ with an FTPS-capable
         client instead. -->
    <publishUrl>ftps://fsapp1server.southcentralus.cloudapp.azure.com</publishUrl>
    <FtpSitePath>FS.Proxy</FtpSitePath>
    <FtpPassiveMode>true</FtpPassiveMode>
    <UserName>ftp_deploy</UserName>
    <_SavePWD>true</_SavePWD>

    <!-- Keep stale files. Vite fingerprints every asset, so leaving the previous build's chunks in
         place is what lets a session that is mid-navigation finish instead of hitting a 404. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>

    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <SiteUrlToLaunchAfterPublish>https://proxy.falcontenders.com/</SiteUrlToLaunchAfterPublish>
  </PropertyGroup>
</Project>

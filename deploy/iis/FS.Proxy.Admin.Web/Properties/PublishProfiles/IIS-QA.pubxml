<?xml version="1.0" encoding="utf-8"?>
<!--
  Admin SPA → IIS site "FS.Proxy" on fsqa1server, over FTP with explicit TLS.

  Visual Studio only, same as the Production profile: FTP lives in Visual Studio's web publishing
  pipeline, not in Microsoft.NET.Sdk.Publish. To validate the QA payload from the CLI first:

    dotnet publish deploy/iis/FS.Proxy.Admin.Web -p:PublishProfile=Folder-Test \
      -p:AdminRuntimeConfig=config.qa.json

  The password is not stored here — _SavePWD puts it in the sibling IIS-QA.pubxml.user, which
  .gitignore still excludes.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <ExcludeApp_Data>false</ExcludeApp_Data>

    <!-- Points the build at the QA API. This is the one line that must differ from IIS-Prod, and
         getting it wrong is silent: the SPA would come up on the QA host talking to production. -->
    <AdminRuntimeConfig>config.qa.json</AdminRuntimeConfig>

    <!-- ftps:// selects explicit TLS on the control channel; port 21 is the default. If transfers
         fail after a successful login, it is IIS FTP requiring TLS session reuse, which Visual
         Studio's FtpWebRequest client does not do. -->
    <publishUrl>ftps://fsqa1server.southcentralus.cloudapp.azure.com</publishUrl>
    <FtpSitePath>FS.Proxy</FtpSitePath>
    <FtpPassiveMode>true</FtpPassiveMode>
    <UserName>ftp_deploy</UserName>
    <_SavePWD>true</_SavePWD>

    <!-- Keep stale files: Vite fingerprints every asset, so the previous build's chunks let an
         in-flight session finish instead of 404ing. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>

    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <SiteUrlToLaunchAfterPublish>https://proxy-qa.falcontenders.com/</SiteUrlToLaunchAfterPublish>
  </PropertyGroup>
</Project>

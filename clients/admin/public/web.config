<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the admin SPA. Vite copies public/ verbatim into dist/, so this ships to the
  site root with the build. It mirrors what clients/admin/docker/nginx.conf does for the container
  deploy: history-API fallback, no-store on the two files that must never be cached, and immutable
  caching for the content-hashed assets.

  Requires the IIS URL Rewrite Module 2.1 on the server — without it IIS fails the whole site with a
  500.19 on the <rewrite> section rather than silently ignoring it.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Remove-then-add: IIS throws a 500.19 duplicate-entry error if the extension is already
           mapped at the server level. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Client-side routing: anything that is not a real file or directory renders the shell,
             so a deep link like /tenants/root reloads instead of 404ing. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="DENY" />
        <!-- IIS advertises itself on every response; the SPA has nothing to gain from that. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- index.html and config.json are the two files that must always be revalidated: the shell
       references hashed asset names, and config.json is what points the build at an environment.
       Caching either one pins clients to a stale deploy. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="config.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Vite fingerprints everything under assets/, so it is safe to cache for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
